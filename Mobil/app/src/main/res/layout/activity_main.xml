<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9fa">

    <androidx.cardview.widget.CardView
        android:id="@+id/screenCard"
        android:layout_width="350dp"
        android:layout_height="250dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="15dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/screenView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:scaleType="fitXY" />
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/tam_ekran"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:backgroundTint="#0ea651"
        android:onClick="tam_ekran"
        android:text="Tam Ekran Yap"
        android:textColor="#ffffff"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/screenCard" />

    <HorizontalScrollView
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:background="#ffffff"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <Button
                android:id="@+id/btn_geri"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#ffffff"
                android:onClick="dikey_yap"
                android:text="Dikey Mod"
                android:textColor="#3c4043"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                app:strokeColor="#bdc1c6"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btn_tikla"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#0ea651"
                android:onClick="tikla"
                android:text="Çift Tık"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btn_sag_tikla"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#202124"
                android:onClick="sag_tikla"
                android:text="Sağ Tık"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btn_klavye"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#16a085"
                android:onClick="klavye_ac"
                android:text="Klavye Yaz"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btn_enter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#f2994a"
                android:onClick="enter_bas"
                android:text="ENTER"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btn_alttab"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#009688"
                android:onClick="alt_tab_yap"
                android:text="Pencereler (Alt+Tab)"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btn_cmd"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1a73e8"
                android:onClick="cmd_ac"
                android:text="CMD Aç"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btn_taskmgr"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#e06666"
                android:onClick="task_manager_ac"
                android:text="Görev Yön."
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btn_desktop"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#7851a9"
                android:onClick="masaustunu_goster"
                android:text="Masaüstü"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btn_esc"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#7f8c8d"
                android:onClick="esc_bas"
                android:text="ESC"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/iot_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="224dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_motor_calistir"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#0ea651"
            android:onClick="motor_calistir"
            android:text="MOTORU ÇALIŞTIR"
            android:textColor="#ffffff"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btn_motor_kapat"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#d93025"
            android:onClick="motor_kapat"
            android:text="MOTORU KAPAT"
            android:textColor="#ffffff"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>